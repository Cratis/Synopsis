<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Executables and tools run on the latest .NET only; the library keeps net10.0;net11.0. -->
    <TargetFrameworks>net11.0</TargetFrameworks>
    <AssemblyName>Cratis.Synopsis.Tool</AssemblyName>
    <RootNamespace>Cratis.Synopsis.Tool</RootNamespace>
    <PackageId>Cratis.Synopsis.Tool</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>synopsis</ToolCommandName>
    <Description>Turn C#, TypeScript, and Screenplay BDD specifications into a beautiful living behavior document</Description>
    <PackageTags>bdd;specifications;documentation;living-documentation;gherkin;specflow;reqnroll;dotnet-tool;spec-by-example;behavior-driven-development;cratis</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Synopsis/Synopsis.csproj" />
  </ItemGroup>
</Project>
